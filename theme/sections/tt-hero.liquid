{% render 'tt-boot' %}
<script src="{{ 'tt-split.js' | asset_url }}" defer></script>
<script src="{{ 'tt-hero.js' | asset_url }}" defer></script>

{%- liquid
  assign contact_label = section.settings.contact_label | default: 'Contact us'
  assign contact_link = section.settings.contact_link
  assign duration = section.settings.autoplay_duration | default: 5 | times: 1000
  assign hero_caption = section.settings.caption | default: 'Welcome To TenTwenty Farms'
  assign hero_title = section.settings.title | default: 'From our Farms|to your hands'
-%}

<section class="tt-hero-section" {{ section.shopify_attributes }}>
  <tt-hero class="tt-hero" data-duration="{{ duration }}">
    {% render 'tt-header',
      menu: section.settings.menu,
      contact_label: contact_label,
      contact_link: contact_link
    %}

    <div class="tt-hero__slides">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            <div
              class="tt-hero__slide{% if forloop.first %} is-active{% endif %}"
              data-tt-slide
              {{ block.shopify_attributes }}
            >
              <div class="tt-hero__media">
                {%- if block.settings.image != blank -%}
                  {%- if forloop.first -%}
                    {{
                      block.settings.image
                      | image_url: width: 2400
                      | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: hero_caption
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 2400
                      | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: hero_caption
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- assign fallback = 'tt-hero-1.png' -%}
                  {%- if forloop.index == 2 -%}{%- assign fallback = 'tt-hero-next.png' -%}{%- endif -%}
                  {%- if forloop.index == 3 -%}{%- assign fallback = 'tt-gallery-2.png' -%}{%- endif -%}
                  {%- if forloop.index >= 4 -%}{%- assign fallback = 'tt-gallery-3.png' -%}{%- endif -%}
                  <img
                    src="{{ fallback | asset_url }}"
                    alt="{{ hero_caption | escape }}"
                    width="2400"
                    height="1350"
                    {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  >
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="tt-hero__slide is-active" data-tt-slide>
          <div class="tt-hero__media">
            <img
              src="{{ 'tt-hero-1.png' | asset_url }}"
              alt="{{ hero_caption | escape }}"
              width="2400"
              height="1350"
              fetchpriority="high"
            >
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="tt-hero__content">
      <p class="tt-hero__caption" data-tt-caption>{{ hero_caption }}</p>
      <h1 class="tt-hero__title" data-tt-title data-split-text="{{ hero_title | escape }}">
        {%- assign title_lines = hero_title | split: '|' -%}
        {%- for line in title_lines -%}
          {{- line | strip -}}
          {%- unless forloop.last -%}<br>{%- endunless -%}
        {%- endfor -%}
      </h1>
    </div>

    <div class="tt-hero__controls">
      <button type="button" class="tt-hero__next" data-tt-next aria-label="Next slide">
        <span class="tt-hero__next-frame" aria-hidden="true"></span>
        <span class="tt-hero__next-progress" aria-hidden="true">
          <svg viewBox="0 0 138 138" fill="none">
            <path
              data-tt-progress
              d="M4 4H134V134H4Z"
              pathLength="520"
              stroke-dasharray="520"
              stroke-dashoffset="520"
            ></path>
          </svg>
        </span>
        <span class="tt-hero__next-thumb" data-tt-next-thumb>
          <img
            class="tt-hero__next-thumb-img is-base"
            data-tt-next-img
            src="{{ 'tt-hero-next.png' | asset_url }}"
            alt=""
            width="138"
            height="138"
          >
          <img
            class="tt-hero__next-thumb-img is-incoming"
            data-tt-next-img-in
            src=""
            alt=""
            width="138"
            height="138"
            hidden
          >
        </span>
        <span class="tt-hero__next-label">Next</span>
      </button>
      <div class="tt-hero__counter" aria-live="polite">
        <span data-tt-current>01</span>
        <span class="tt-hero__counter-line" aria-hidden="true"></span>
        <span data-tt-total>04</span>
      </div>
    </div>
  </tt-hero>
</section>

{% schema %}
{
  "name": "TT Hero Banner",
  "tag": "section",
  "class": "tt-section-hero",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header menu",
      "info": "Leave empty to use shop collection defaults"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact button link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (shared on all slides)",
      "default": "Welcome To TenTwenty Farms"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title (shared on all slides)",
      "default": "From our Farms|to your hands",
      "info": "Use | for a line break. This message stays the same while images change."
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay duration",
      "default": 5,
      "info": "Border around Next thumbnail fills over this duration"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TT Hero Banner",
      "settings": {
        "caption": "Welcome To TenTwenty Farms",
        "title": "From our Farms|to your hands"
      },
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
