{% render 'tt-boot' %}
<script src="{{ 'tt-split.js' | asset_url }}" defer></script>
<script src="{{ 'tt-gallery.js' | asset_url }}" defer></script>

<section class="tt-quality" id="quality-products" {{ section.shopify_attributes }}>
  <div class="tt-quality__intro">
    <h2 class="tt-quality__title" data-tt-quality-title>{{ section.settings.heading }}</h2>
    <div class="tt-quality__text" data-tt-quality-text>
      {{ section.settings.text }}
    </div>
  </div>

  <tt-gallery
    class="tt-gallery"
    data-start="{{ section.settings.start_index }}"
  >
    <div class="tt-gallery__viewport">
      <div class="tt-gallery__track" data-tt-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'client' -%}
              <article
                class="tt-gallery__slide"
                data-tt-gallery-slide
                data-client="{{ block.settings.client_name | escape }}"
                data-location="{{ block.settings.location | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width: 989px) 233px, 435px', alt: block.settings.client_name
                  }}
                {%- else -%}
                  {%- assign gimg = 'tt-gallery-1.png' -%}
                  {%- case forloop.index -%}
                    {%- when 1 -%}{%- assign gimg = 'tt-gallery-4.png' -%}
                    {%- when 2 -%}{%- assign gimg = 'tt-gallery-2.png' -%}
                    {%- when 3 -%}{%- assign gimg = 'tt-gallery-1.png' -%}
                    {%- when 4 -%}{%- assign gimg = 'tt-gallery-3.png' -%}
                    {%- when 5 -%}{%- assign gimg = 'tt-gallery-5.png' -%}
                    {%- else -%}{%- assign gimg = 'tt-gallery-6.png' -%}
                  {%- endcase -%}
                  <img src="{{ gimg | asset_url }}" alt="{{ block.settings.client_name | escape }}" loading="lazy" width="435" height="619">
                {%- endif -%}
                <div class="tt-gallery__drag" aria-hidden="true">Drag</div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="tt-gallery__meta">
      <h3 class="tt-gallery__client" data-tt-client>Client 1</h3>
      <p class="tt-gallery__location" data-tt-location>Dubai, United Arab Emirates</p>
    </div>
  </tt-gallery>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.TTSplit) return;
    var title = document.querySelector('[data-tt-quality-title]');
    var text = document.querySelector('[data-tt-quality-text]');
    if (title) window.TTSplit.observeInView(title, { once: true });
    if (text) window.TTSplit.observeInView(text, { once: true });
  });
</script>

{% schema %}
{
  "name": "TT Quality Gallery",
  "tag": "section",
  "class": "tt-section-quality",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality Products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
    },
    {
      "type": "range",
      "id": "start_index",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Starting slide index",
      "default": 2,
      "info": "0-based index of the centered client card on load"
    }
  ],
  "blocks": [
    {
      "type": "client",
      "name": "Client slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "client_name",
          "label": "Client name",
          "default": "Client 1"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Dubai, United Arab Emirates"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TT Quality Gallery",
      "blocks": [
        {
          "type": "client",
          "settings": {
            "client_name": "Client 6",
            "location": "Abu Dhabi, United Arab Emirates"
          }
        },
        {
          "type": "client",
          "settings": {
            "client_name": "Client 2",
            "location": "London, United Kingdom"
          }
        },
        {
          "type": "client",
          "settings": {
            "client_name": "Client 1",
            "location": "Dubai, United Arab Emirates"
          }
        },
        {
          "type": "client",
          "settings": {
            "client_name": "Client 3",
            "location": "Singapore"
          }
        },
        {
          "type": "client",
          "settings": {
            "client_name": "Client 4",
            "location": "Hong Kong"
          }
        },
        {
          "type": "client",
          "settings": {
            "client_name": "Client 5",
            "location": "Istanbul, Turkey"
          }
        }
      ]
    }
  ]
}
{% endschema %}
