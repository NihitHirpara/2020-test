<a class="tt-card" href="{{ product.url }}">
  <div class="tt-card__media">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 22vw, 45vw', alt: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'tt-card__ph' }}
    {%- endif -%}
  </div>
  <div class="tt-card__copy">
    <h3>{{ product.title }}</h3>
    <p>{{ product.price | money }}</p>
  </div>
</a>
